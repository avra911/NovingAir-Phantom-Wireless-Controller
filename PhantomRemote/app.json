{
  "expo": {
    "name": "PhantomRemote",
    "slug": "PhantomRemote",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "phantomremote",
    "userInterfaceStyle": "automatic",
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.samezenbody.PhantomRemote"
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f81ce4bc-bd28-46cc-81a4-98a487d8962c"
      }
    }
  }
}
