{
  "expo": {
    "name": "PhantomRemote",
    "slug": "PhantomRemote",
    "version": "1.0.1",
    "orientation": "portrait",
    "scheme": "phantomremote",
    "userInterfaceStyle": "automatic",
    "android": {
      "predictiveBackGestureEnabled": false,
      "usesCleartextTraffic": true,
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ],
      "package": "com.samezenbody.PhantomRemote",
      "versionCode": 2
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f81ce4bc-bd28-46cc-81a4-98a487d8962c"
      }
    },
    "owner": "same-zen-bodys-organization"
  }
}
